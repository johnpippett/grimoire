# Grimoire wiki-RAG host configuration.
#
# Copy this file to config/wiki-rag.env and replace the required value with the
# absolute directory that contains one direct child directory per project.
# Never commit config/wiki-rag.env: it is intentionally ignored because it can
# contain private machine paths.

# Required. Each direct child is discovered as one project. A project can
# provide wiki/ and/or Project Vault/, project-vault/, or ProjectVault/.
WIKI_RAG_PROJECTS_ROOT=

# Optional. Derived JSONL indexes and logs default to ~/.wiki-rag.
WIKI_RAG_HOME=

# Optional. The refresh script searches PATH, ~/.local/bin/uv, and
# ~/.hermes/bin/uv when this is empty.
UV_BIN=
